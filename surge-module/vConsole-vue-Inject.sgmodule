#!name=vConsole 注入
#!desc=向指定网页注入 vConsole 调试面板，可选加载 Vue Devtools 插件。需开启 MITM 总开关并信任 CA 证书。
#!category=开发调试
#!arguments=HOSTNAME:www.example.com,PATHPREFIX:/,CDN:https://unpkg.com/vconsole@latest/dist/vconsole.min.js,VUEDEVTOOLS:false,VUEPLUGINURL:https://cdn.jsdelivr.net/npm/vue-vconsole-devtools@1.0.5/dist/vue_plugin.js
#!arguments-desc=[参数设置]\n\n⓵ HOSTNAME: 需要注入的域名，会自动加入 MITM 列表。\n\n⓶ PATHPREFIX: 页面路径前缀。默认 / 表示该域名下所有页面；只调试子路径可填 /mobile/ 。\n\n⓷ CDN: vConsole 的地址，默认 latest。内网环境可换成自建地址。\n\n⓸ VUEDEVTOOLS: 是否加载 Vue Devtools 插件，填 true 开启，其他值均视为关闭。\n\n⓹ VUEPLUGINURL: Vue Devtools 插件地址，VUEDEVTOOLS 为 false 时不会被请求。\n\n[注意事项]\n参数值中不能包含英文逗号，也不要留空，否则参数表会加载异常。
#!requirement=CORE_VERSION>=20

[MITM]
hostname = %APPEND% {{{HOSTNAME}}}

# 去掉 CSP，否则页面可能拒绝加载外部 CDN 的脚本
[Header Rewrite]
http-response ^https://{{{HOSTNAME}}}{{{PATHPREFIX}}} header-del Content-Security-Policy
http-response ^https://{{{HOSTNAME}}}{{{PATHPREFIX}}} header-del Content-Security-Policy-Report-Only

# Body Rewrite 的参数以空格分隔，替换内容中不能出现任何空格，
# 因此 JS 片段做了 percent-encoding，由 decodeURIComponent 在页面内还原；
# 三个参数值本身不含空格，拆成字符串拼接以便占位符替换。
#
# 解码后的实际逻辑：
#   (function(){
#     var d=document, c="{{{CDN}}}", g="{{{VUEDEVTOOLS}}}", p="{{{VUEPLUGINURL}}}";
#     var v=(g==="true")?p:"";
#     function L(u,f){var s=d.createElement("script");s.src=u;s.onload=f;d.head.appendChild(s)}
#     L(c,function(){
#       if(!window.VConsole)return;
#       window.vConsole=window.vConsole||new window.VConsole();
#       if(v){L(v,function(){
#         var E=window.vueVconsoleDevtools;
#         if(E&&E.default){E=E.default}
#         if(E&&E.initPlugin){E.initPlugin(window.vConsole)}
#       })}
#     })
#   })()
[Body Rewrite]
http-response ^https://{{{HOSTNAME}}}{{{PATHPREFIX}}}[^.?]*(\.html?)?(\?|$) </head> <script>document.write(decodeURIComponent('%3Cscript%3E(function()%7Bvar%20d%3Ddocument%2Cc%3D%22')+'{{{CDN}}}'+decodeURIComponent('%22%2Cg%3D%22')+'{{{VUEDEVTOOLS}}}'+decodeURIComponent('%22%2Cp%3D%22')+'{{{VUEPLUGINURL}}}'+decodeURIComponent('%22%2Cv%3D(g%3D%3D%3D%22true%22)%3Fp%3A%22%22%3Bfunction%20L(u%2Cf)%7Bvar%20s%3Dd.createElement(%22script%22)%3Bs.src%3Du%3Bs.onload%3Df%3Bd.head.appendChild(s)%7DL(c%2Cfunction()%7Bif(!window.VConsole)return%3Bwindow.vConsole%3Dwindow.vConsole%7C%7Cnew%20window.VConsole()%3Bif(v)%7BL(v%2Cfunction()%7Bvar%20E%3Dwindow.vueVconsoleDevtools%3Bif(E%26%26E.default)%7BE%3DE.default%7Dif(E%26%26E.initPlugin)%7BE.initPlugin(window.vConsole)%7D%7D)%7D%7D)%7D)()%3C%2Fscript%3E'))</script></head>
